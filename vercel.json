{
  "redirects": [
    { "source": "/exchanges/:slug(bybit|bingx|kucoin|okx|mexc|gate)", "destination": "/exchanges/", "permanent": true },
    { "source": "/exchanges/:slug(bybit|bingx|kucoin|okx|mexc|gate)/", "destination": "/exchanges/", "permanent": true },
    { "source": "/en/exchanges/:slug(bybit|bingx|kucoin|okx|mexc|gate)", "destination": "/en/exchanges/", "permanent": true },
    { "source": "/en/exchanges/:slug(bybit|bingx|kucoin|okx|mexc|gate)/", "destination": "/en/exchanges/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://open.er-api.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
